// AI SDR Dashboard — data model
// Docs: https://pris.ly/d/prisma-schema
//
// QuickMail is the system of record for sending. This database holds the
// orchestration layer: users, imported leads, templates, AI output and the
// human approvals that gate anything outbound.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------- auth

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password_hash String
  role          UserRole @default(MEMBER)
  created_at    DateTime @default(now())

  approvals Approval[]
}

// ---------------------------------------------------------------- leads

enum LeadStatus {
  UNCONTACTED
  EMAILED
  REPLIED
  BOUNCED
  DNC
  MEETING_BOOKED
}

/** Where a lead came from, so a bad import can be traced and rolled back. */
enum LeadSource {
  MANUAL
  CSV
  EXCEL
  JSON
  QUICKMAIL
  MOCK
}

model Lead {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String?
  first_name      String?
  last_name       String?
  company         String?
  title           String?
  phone           String?
  location        String?
  status          LeadStatus @default(UNCONTACTED)
  ai_intent_score Int        @default(0)
  source          LeadSource @default(MANUAL)

  /** Set once the lead exists in QuickMail, so we never double-create. */
  quickmail_lead_id String?

  /** Stops every outbound step for this lead — set on negative replies. */
  suppressed        Boolean @default(false)
  suppressed_reason String?

  import_batch_id String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  importBatch ImportBatch? @relation(fields: [import_batch_id], references: [id], onDelete: SetNull)
  emailLogs   EmailLog[]
  approvals   Approval[]

  @@index([status])
  @@index([suppressed])
}

/** One upload. Keeps per-file stats so a messy import can be audited. */
model ImportBatch {
  id           String     @id @default(cuid())
  filename     String
  source       LeadSource
  total_rows   Int        @default(0)
  imported     Int        @default(0)
  duplicates   Int        @default(0)
  invalid      Int        @default(0)
  created_at   DateTime   @default(now())

  leads Lead[]
}

/**
 * Local mirror of QuickMail's sending mailboxes and workspace.
 *
 * Same reason as the cached campaign stats: the API rate-limits bursts, so a
 * live lookup in a page render breaks whenever a sync is running.
 */
model QmMailbox {
  id           String   @id
  email        String
  workspace_id String?
  synced_at    DateTime @default(now())

  /**
   * Whether setCampaignEmailAccounts works for this mailbox.
   *
   * QuickMail 500s for some accounts and succeeds for others, with no
   * discoverable reason — so this is learned from experience: null until
   * tried, false once an assignment has failed.
   */
  assignable      Boolean?
  assign_error_at DateTime?

  /**
   * QuickMail's own view of the connection. A deauthorized mailbox (expired or
   * revoked OAuth) accepts being attached to a campaign and then silently sends
   * nothing — leads sit at "active" forever with no error anywhere. Synced from
   * the API so a campaign can't be built on a dead sender.
   */
  authorized Boolean?
  qm_paused  Boolean?
}

// ------------------------------------------------------------ templates

model Template {
  id         String   @id @default(cuid())
  name       String
  subject    String
  body       String
  /** Inbox preheader. Null for templates imported before this existed. */
  preview    String?
  /** Prompt used if this was generated by Claude, for regeneration/audit. */
  ai_prompt  String?

  /** Service line the template belongs to, e.g. "Manual Lease Abstraction". */
  category String?
  /** Position in the sequence: 1 is the first touch, 2 and 3 the follow-ups. */
  step     Int?
  /** Where it came from — a .docx brief, the UI, or Claude. */
  source   String?
  /** Targeting from the brief, stored as JSON so it survives round-tripping. */
  geography String?
  industry  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  campaigns Campaign[]
  steps     CampaignStep[]
}

// ------------------------------------------------------------ campaigns

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  status      CampaignStatus @default(DRAFT)
  template_id String?

  /** Mirrors the campaign created on QuickMail's side, once approved. */
  quickmail_campaign_id String?
  /** JSON array of QuickMail emailAccount IDs used for sending. */
  mailbox_ids           String?

  /**
   * Cached QuickMail stats. The API caps pages at 10 and rate-limits bursts,
   * so it must not sit in the page render path — the dashboard reads these and
   * the sync refreshes them.
   */
  qm_paused       Boolean?
  qm_archived     Boolean   @default(false)
  qm_leads_total  Int       @default(0)
  qm_sent         Int       @default(0)
  qm_delivered    Int       @default(0)
  qm_opens        Int       @default(0)
  qm_clicks       Int       @default(0)
  qm_replies      Int       @default(0)
  qm_replies_pos  Int       @default(0)
  qm_bounces      Int       @default(0)
  qm_unsubscribes Int       @default(0)
  qm_app_url      String?
  synced_at       DateTime?

  /**
   * Campaign window enforced by this app, not QuickMail.
   *
   * QuickMail has no campaign start/end field, but updateEmailStep accepts
   * `paused` per variation — so the scheduler pauses every email variation
   * until the start moment and re-pauses them at the end.
   */
  scheduled_start DateTime?
  scheduled_end   DateTime?
  /** PENDING → waiting to start · RUNNING → sending · ENDED → stopped. */
  schedule_state  String?
  schedule_note   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /**
   * The agent chat that produced this campaign, when it came from the AI agent
   * rather than the manual builder. Lets the campaign list separate the two and
   * link back to the conversation that specified it.
   */
  agent_conversation_id String?

  template          Template?          @relation(fields: [template_id], references: [id], onDelete: SetNull)
  agentConversation AgentConversation? @relation(fields: [agent_conversation_id], references: [id], onDelete: SetNull)
  steps             CampaignStep[]
  emailLogs         EmailLog[]

  @@index([agent_conversation_id])
}

enum StepType {
  EMAIL
  WAIT
}

/** An ordered step in a sequence: an email, or a delay before the next one. */
model CampaignStep {
  id          String   @id @default(cuid())
  campaign_id String
  position    Int
  type        StepType

  /** EMAIL steps: copy lives here or on a linked template. */
  subject     String?
  body        String?
  template_id String?

  /** WAIT steps: how long to pause before the following step. */
  wait_days Int?

  created_at DateTime @default(now())

  campaign Campaign  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  @@index([campaign_id, position])
}

// ----------------------------------------------------------- activity

enum EmailLogType {
  SENT
  QUEUED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MEETING_REQUEST
  OUT_OF_OFFICE
  UNSUBSCRIBE
}

model EmailLog {
  id          String       @id @default(cuid())
  lead_id     String
  campaign_id String?
  type        EmailLogType
  content     String?

  /** Populated by the AI classifier on inbound replies. */
  sentiment       Sentiment?
  sentiment_score Int?

  created_at DateTime @default(now())

  lead     Lead      @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)

  @@index([lead_id])
  @@index([type])
  @@index([sentiment])
}

// ----------------------------------------------------------- approvals

/** Everything outbound or irreversible is gated behind one of these. */
enum ApprovalType {
  CAMPAIGN_LAUNCH
  REPLY_SEND
  MEETING_BOOK
  LEAD_PUSH
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id      String         @id @default(cuid())
  type    ApprovalType
  status  ApprovalStatus @default(PENDING)
  lead_id String?

  title   String
  /** What the user is approving — the AI draft, or a JSON action payload. */
  summary String?
  payload String?

  /** Editable AI proposal; what actually ships if approved. */
  ai_draft String?

  resolved_by String?
  resolved_at DateTime?
  created_at  DateTime  @default(now())

  lead     Lead? @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  resolver User? @relation(fields: [resolved_by], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
}

/// One AI-agent conversation, kept so earlier chats can be reopened.
///
/// The agent is the main way campaigns get built, and a prompt that produced a
/// good campaign is worth going back to. Messages and the resolved spec are
/// stored whole as JSON — this is a log to re-read, not something to query into.
model AgentConversation {
  id         String   @id @default(cuid())
  /// First user prompt, trimmed, used as the list label.
  title      String
  /// The full Msg[] transcript.
  messages   String
  /// CampaignSpec at the point it was saved.
  spec       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// Campaigns this conversation produced. Usually none or one.
  campaigns Campaign[]

  @@index([updated_at])
}

/// Addresses that must never be emailed again.
///
/// Keyed on the address itself, not a Lead row, and deliberately never deleted
/// with the lead. Re-importing a spreadsheet creates a fresh Lead and would
/// otherwise resurrect a dead address — which is exactly what has been
/// happening: roughly 41 bounce events per unique bad address across the
/// account, and 139 campaigns above a 5% bounce rate.
///
/// QuickMail's API cannot supply historical bounces (no lead-level
/// deliverability field, no bounce query, only per-campaign totals), so this is
/// fed by the bounce webhook, by CSV exports from QuickMail, and by negative
/// or unsubscribe replies.
model Suppression {
  id    String @id @default(cuid())
  /// Always stored lowercased and trimmed.
  email String @unique

  reason SuppressionReason
  /// Where it came from: webhook, import, reply, manual.
  source String

  /// How many times this address has bounced. A repeat offender is evidence the
  /// import pipeline keeps reintroducing it.
  hits Int @default(1)

  note       String?
  first_seen DateTime @default(now())
  last_seen  DateTime @updatedAt

  @@index([reason])
  @@index([last_seen])
}

enum SuppressionReason {
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
  NEGATIVE_REPLY
  MANUAL
}
