// AI SDR Dashboard — data model
// Docs: https://pris.ly/d/prisma-schema
//
// QuickMail is the system of record for sending. This database holds the
// orchestration layer: users, imported leads, templates, AI output and the
// human approvals that gate anything outbound.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------- auth

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password_hash String
  role          UserRole @default(MEMBER)
  created_at    DateTime @default(now())

  approvals Approval[]
  activity  ActivityLog[]
}

// ---------------------------------------------------------------- leads

enum LeadStatus {
  UNCONTACTED
  EMAILED
  REPLIED
  BOUNCED
  DNC
  MEETING_BOOKED
}

/** Where a lead came from, so a bad import can be traced and rolled back. */
enum LeadSource {
  MANUAL
  CSV
  EXCEL
  JSON
  QUICKMAIL
  MOCK
}

model Lead {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String?
  first_name      String?
  last_name       String?
  company         String?
  title           String?
  phone           String?
  location        String?
  status          LeadStatus @default(UNCONTACTED)
  ai_intent_score Int        @default(0)
  source          LeadSource @default(MANUAL)

  /** Set once the lead exists in QuickMail, so we never double-create. */
  quickmail_lead_id String?

  /** Stops every outbound step for this lead — set on negative replies. */
  suppressed        Boolean @default(false)
  suppressed_reason String?

  import_batch_id String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  importBatch   ImportBatch?     @relation(fields: [import_batch_id], references: [id], onDelete: SetNull)
  emailLogs     EmailLog[]
  approvals     Approval[]
  conversations QmConversation[]

  @@index([status])
  @@index([suppressed])
}

/** One upload. Keeps per-file stats so a messy import can be audited. */
model ImportBatch {
  id           String     @id @default(cuid())
  filename     String
  source       LeadSource
  total_rows   Int        @default(0)
  imported     Int        @default(0)
  duplicates   Int        @default(0)
  invalid      Int        @default(0)
  created_at   DateTime   @default(now())

  leads Lead[]
}

/**
 * Local mirror of QuickMail's sending mailboxes and workspace.
 *
 * Same reason as the cached campaign stats: the API rate-limits bursts, so a
 * live lookup in a page render breaks whenever a sync is running.
 */
model QmMailbox {
  id           String   @id
  email        String
  workspace_id String?
  synced_at    DateTime @default(now())

  /**
   * Whether setCampaignEmailAccounts works for this mailbox.
   *
   * QuickMail 500s for some accounts and succeeds for others, with no
   * discoverable reason — so this is learned from experience: null until
   * tried, false once an assignment has failed.
   */
  assignable      Boolean?
  assign_error_at DateTime?

  /**
   * QuickMail's own view of the connection. A deauthorized mailbox (expired or
   * revoked OAuth) accepts being attached to a campaign and then silently sends
   * nothing — leads sit at "active" forever with no error anywhere. Synced from
   * the API so a campaign can't be built on a dead sender.
   */
  authorized Boolean?
  qm_paused  Boolean?

  /**
   * QuickMail's own deliverability verdict on this sender.
   *
   * `accredited` false means QuickMail has judged the mailbox unfit to send —
   * its mail is the kind that lands in spam. It is not something the v2 API
   * exposes; it comes from the same internal endpoint the inbox list uses, so
   * it is mirrored here rather than fetched while a page renders.
   *
   * `score` is their health number, and is null for most mailboxes: it only
   * appears once a mailbox has been through the auto-warmer.
   */
  accredited    Boolean?
  score         Int?
  paused_reason String?
  has_warmer    Boolean?

  /// Today's sending, against the mailbox's own daily cap.
  daily_sent  Int?
  daily_quota Int?

  /// When the health fields above were last read. Null means never.
  health_at DateTime?
}

// ------------------------------------------------------------ templates

/**
 * What a template is for.
 *
 * A separate axis from `category`, which is the service line: "Manual Lease
 * Abstraction" describes the offer, this describes the moment. The two are
 * independent, so a service line can carry a first mail, its follow-ups, and
 * the replies to send once someone answers.
 */
enum TemplateKind {
  FIRST_MAIL
  FOLLOW_UP
  POSITIVE_REPLY
  NEGATIVE_REPLY
}

model Template {
  id         String   @id @default(cuid())
  name       String
  subject    String
  body       String

  /// What moment this template is written for. Backfilled from `step`.
  kind TemplateKind @default(FIRST_MAIL)
  /** Inbox preheader. Null for templates imported before this existed. */
  preview    String?
  /** Prompt used if this was generated by Claude, for regeneration/audit. */
  ai_prompt  String?

  /** Service line the template belongs to, e.g. "Manual Lease Abstraction". */
  category String?
  /** Position in the sequence: 1 is the first touch, 2 and 3 the follow-ups. */
  step     Int?
  /** Where it came from — a .docx brief, the UI, or Claude. */
  source   String?
  /** Targeting from the brief, stored as JSON so it survives round-tripping. */
  geography String?
  industry  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  campaigns Campaign[]
  steps     CampaignStep[]

  @@index([kind])
}

// ------------------------------------------------------------ campaigns

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  status      CampaignStatus @default(DRAFT)
  template_id String?

  /** Mirrors the campaign created on QuickMail's side, once approved. */
  quickmail_campaign_id String?
  /** JSON array of QuickMail emailAccount IDs used for sending. */
  mailbox_ids           String?

  /**
   * Cached QuickMail stats. The API caps pages at 10 and rate-limits bursts,
   * so it must not sit in the page render path — the dashboard reads these and
   * the sync refreshes them.
   */
  qm_paused       Boolean?
  qm_archived     Boolean   @default(false)
  qm_leads_total  Int       @default(0)
  qm_sent         Int       @default(0)
  qm_delivered    Int       @default(0)
  qm_opens        Int       @default(0)
  qm_clicks       Int       @default(0)
  qm_replies      Int       @default(0)
  qm_replies_pos  Int       @default(0)
  qm_bounces      Int       @default(0)
  qm_unsubscribes Int       @default(0)
  qm_app_url      String?
  synced_at       DateTime?

  /**
   * Campaign window enforced by this app, not QuickMail.
   *
   * QuickMail has no campaign start/end field, but updateEmailStep accepts
   * `paused` per variation — so the scheduler pauses every email variation
   * until the start moment and re-pauses them at the end.
   */
  scheduled_start DateTime?
  scheduled_end   DateTime?
  /** PENDING → waiting to start · RUNNING → sending · ENDED → stopped. */
  schedule_state  String?
  schedule_note   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /**
   * The agent chat that produced this campaign, when it came from the AI agent
   * rather than the manual builder. Lets the campaign list separate the two and
   * link back to the conversation that specified it.
   */
  agent_conversation_id String?

  template          Template?          @relation(fields: [template_id], references: [id], onDelete: SetNull)
  agentConversation AgentConversation? @relation(fields: [agent_conversation_id], references: [id], onDelete: SetNull)
  steps             CampaignStep[]
  emailLogs         EmailLog[]

  @@index([agent_conversation_id])
}

enum StepType {
  EMAIL
  WAIT
}

/** An ordered step in a sequence: an email, or a delay before the next one. */
model CampaignStep {
  id          String   @id @default(cuid())
  campaign_id String
  position    Int
  type        StepType

  /** EMAIL steps: copy lives here or on a linked template. */
  subject     String?
  body        String?
  template_id String?

  /** WAIT steps: how long to pause before the following step. */
  wait_days Int?

  created_at DateTime @default(now())

  campaign Campaign  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  @@index([campaign_id, position])
}

// ----------------------------------------------------------- activity

enum EmailLogType {
  SENT
  QUEUED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MEETING_REQUEST
  OUT_OF_OFFICE
  UNSUBSCRIBE
}

model EmailLog {
  id          String       @id @default(cuid())
  lead_id     String
  campaign_id String?
  type        EmailLogType
  content     String?

  /** Populated by the AI classifier on inbound replies. */
  sentiment       Sentiment?
  sentiment_score Int?

  /**
   * Reply triage. Set once a human has dealt with an inbound reply.
   *
   * QuickMail can neither send an email nor read replies back — no such
   * mutation or query exists — so a reply is always handled outside the API.
   * This records that it was, so the queue stops showing it.
   */
  handled_at     DateTime?
  /// REPLIED · STOPPED · IGNORED
  handled_action String?

  created_at DateTime @default(now())

  lead     Lead      @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)

  @@index([lead_id])
  @@index([type])
  @@index([sentiment])
}

// ----------------------------------------------------------- approvals

/** Everything outbound or irreversible is gated behind one of these. */
enum ApprovalType {
  CAMPAIGN_LAUNCH
  REPLY_SEND
  MEETING_BOOK
  LEAD_PUSH
  /// A negative reply waiting on a human before the address is barred.
  STOP_SEQUENCE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id      String         @id @default(cuid())
  type    ApprovalType
  status  ApprovalStatus @default(PENDING)
  lead_id String?

  title   String
  /** What the user is approving — the AI draft, or a JSON action payload. */
  summary String?
  payload String?

  /** Editable AI proposal; what actually ships if approved. */
  ai_draft String?

  resolved_by String?
  resolved_at DateTime?
  created_at  DateTime  @default(now())

  lead     Lead? @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  resolver User? @relation(fields: [resolved_by], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
}

/// One AI-agent conversation, kept so earlier chats can be reopened.
///
/// The agent is the main way campaigns get built, and a prompt that produced a
/// good campaign is worth going back to. Messages and the resolved spec are
/// stored whole as JSON — this is a log to re-read, not something to query into.
model AgentConversation {
  id         String   @id @default(cuid())
  /// First user prompt, trimmed, used as the list label.
  title      String
  /// The full Msg[] transcript.
  messages   String
  /// CampaignSpec at the point it was saved.
  spec       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// Campaigns this conversation produced. Usually none or one.
  campaigns Campaign[]

  @@index([updated_at])
}

/// Addresses that must never be emailed again.
///
/// Keyed on the address itself, not a Lead row, and deliberately never deleted
/// with the lead. Re-importing a spreadsheet creates a fresh Lead and would
/// otherwise resurrect a dead address — which is exactly what has been
/// happening: roughly 41 bounce events per unique bad address across the
/// account, and 139 campaigns above a 5% bounce rate.
///
/// QuickMail's API cannot supply historical bounces (no lead-level
/// deliverability field, no bounce query, only per-campaign totals), so this is
/// fed by the bounce webhook, by CSV exports from QuickMail, and by negative
/// or unsubscribe replies.
model Suppression {
  id    String @id @default(cuid())
  /// Always stored lowercased and trimmed.
  email String @unique

  reason SuppressionReason
  /// Where it came from: webhook, import, reply, manual.
  source String

  /// How many times this address has bounced. A repeat offender is evidence the
  /// import pipeline keeps reintroducing it.
  hits Int @default(1)

  note       String?
  first_seen DateTime @default(now())
  last_seen  DateTime @updatedAt

  @@index([reason])
  @@index([last_seen])
}

/// A reply thread mirrored from QuickMail, which calls these "opportunities".
///
/// This exists because reply content cannot be reached any other way. The v2
/// GraphQL API exposes replies only as counts on CampaignStats, and every
/// reply-shaped v1 REST path 404s — both verified against the live account.
/// The data here comes from QuickMail's own web app, read through the signed-in
/// browser session (see src/lib/quickmail/inbox.ts).
///
/// Mirrored rather than fetched per render: the source is an undocumented
/// endpoint behind a browser session, which is far too slow and too fragile to
/// sit in a page's critical path.
model QmConversation {
  /// QuickMail's opportunity id.
  id      String  @id
  lead_id String?

  subject    String?
  state      String?
  status     String?
  /// QuickMail's own AI summary of the thread, when it made one.
  ai_summary String?
  /// QuickMail's classification of the latest reply.
  reply_type String?
  is_ooo     Boolean @default(false)

  waiting_since DateTime?

  /// The message a reply must attach to. Null means QuickMail won't accept one.
  replyable_todo_id String?
  /// The sending mailbox — a reply has to go out from the inbox that received it.
  inbox_id          String?
  inbox_email       String?
  /// Display name on the sending mailbox — what a reply must be signed with.
  inbox_name        String?

  qm_campaign_id String?
  campaign_name  String?

  /// QuickMail's prospect id — what a do-not-contact or cancel is applied to.
  qm_prospect_id   String?
  prospect_email   String?
  prospect_name    String?
  prospect_title   String?
  prospect_company String?
  do_not_contact   Boolean @default(false)

  /// Set once a human has dealt with the thread here.
  handled_at     DateTime?
  /// REPLIED · STOPPED · IGNORED
  handled_action String?

  /// When this thread was emailed to the manager, and to whom.
  ///
  /// Recorded so a re-sync cannot forward the same reply twice — the sync runs
  /// on demand and re-reads threads it has already seen, so "have we sent this"
  /// has to be a stored fact rather than inferred from recency.
  /**
   * "email" or "linkedin", as QuickMail classifies it.
   *
   * LinkedIn outreach is filed as an opportunity exactly like an email thread,
   * but carries no address, no sending mailbox and nothing to reply to. Told
   * apart by their own channelType rather than by guessing from an address
   * that happens to end in @linkedin.profile.
   */
  channel String?

  /**
   * The mailbox that actually ran the campaign, derived from the thread.
   *
   * Not `inbox_email`, which is whichever mailbox touched the opportunity most
   * recently — and forwarding a reply to a manager touches it. That rewrote 57
   * threads to the forwarding mailbox, so the panel reported it as the sender
   * of 57 campaigns when the real sender of 33 of them was somebody else. This
   * comes from the earliest outbound message in the thread, which nothing we
   * do afterwards can change.
   */
  sender_email String?

  forwarded_at DateTime?
  forwarded_to String?

  /**
   * Failed attempts to forward this thread, and the last reason.
   *
   * Some threads can never be forwarded: QuickMail answers "you don't have the
   * permission to todo N" for conversations owned by an inbox the signed-in
   * user cannot act on. Without a count, the queue is ordered newest-first and
   * those threads sit at its head being retried every hour, using up the whole
   * batch and starving the ones that would have gone. Ordering by attempts puts
   * untried threads first and lets repeat failures sink, without ever silently
   * discarding one.
   */
  forward_attempts Int     @default(0)
  forward_error    String?

  synced_at  DateTime @default(now())
  created_at DateTime @default(now())

  lead     Lead?       @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  messages QmMessage[]

  @@index([handled_at])
  @@index([lead_id])
}

/// One email in a mirrored thread, in either direction.
model QmMessage {
  /// QuickMail's todo id — the unit a reply is threaded onto.
  id              String @id
  conversation_id String

  /// IN for a prospect's reply, OUT for something we sent.
  direction String

  subject   String?
  /// HTML as delivered. Rendered sandboxed; never trusted as markup.
  body_html String?
  /// Plain-text rendering, when QuickMail supplies one.
  body_text String?

  from_name  String?
  from_email String?
  to_email   String?
  cc         String?

  sent_at    DateTime?
  created_at DateTime  @default(now())

  conversation QmConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, sent_at])
}

/// Whole domains that must never be emailed.
///
/// Separate from Suppression because it answers a different question. An address
/// block says "this person asked to stop"; a domain block says "nobody at this
/// company should be contacted" — a competitor, a client, our own staff, or a
/// domain whose mail server rejects everything and is quietly burning the
/// sending reputation.
///
/// Enforced locally, at enrolment. QuickMail has an addDncDomains operation but
/// its input shape is not yet known, so a domain block stops campaigns this app
/// builds and does not reach into sequences already running there.
model SuppressedDomain {
  id String @id @default(cuid())

  /// Lowercased, no leading "@" — e.g. "example.com".
  domain String @unique

  reason SuppressionReason
  /// Where it came from: manual, reply-review, bounce-pattern, import.
  source String

  /// How many times an address at this domain has been blocked since.
  hits Int @default(0)

  note       String?
  first_seen DateTime @default(now())
  last_seen  DateTime @updatedAt

  @@index([reason])
}

enum SuppressionReason {
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
  NEGATIVE_REPLY
  MANUAL
}

/**
 * People who receive forwarded replies.
 *
 * Replaces a single MANAGER_EMAIL in .env, which could only be changed by
 * someone at the server with a restart, and could only ever name one person.
 * Handing a reply to whoever is covering this week is an ordinary thing to
 * want, and it should not require an editor and a deploy.
 *
 * Nothing is deleted when someone stops covering: `active` false keeps the
 * record and the history of what was already sent to them.
 */
model Manager {
  id     String  @id @default(cuid())
  email  String  @unique
  name   String?
  active Boolean @default(true)

  /// Free text — "covers EMEA", "out until the 20th".
  note String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([active])
}

/**
 * Small persistent switches the app itself owns.
 *
 * Distinct from the .env knobs, which only a person at the server can change
 * and only by restarting it. These are the ones someone needs to flip while
 * the thing is running — stopping the manager forwarding mid-backlog, say —
 * from whichever machine they happen to have the dashboard open on.
 */
/**
 * Who did what, and when.
 *
 * Nothing recorded it before. Campaign creation, sending a reply, blocking an
 * address — all of it happened with no trace of the person behind it, so
 * "who made this campaign" could only be answered by asking around. The one
 * exception was an approval's `resolved_by`, which is why those records
 * backfill into here.
 *
 * Deliberately append-only and deliberately not a foreign key on the subject:
 * the point is that the record survives the thing it describes being deleted.
 */
model ActivityLog {
  id String @id @default(cuid())

  at DateTime @default(now())

  /// Null for anything that happened before this log existed, or for the timer.
  user_id String?

  /**
   * The person's name as it was at the time.
   *
   * Kept alongside the relation because removing an account sets user_id to
   * null, and a line with no user reads as work the app did on its own. A
   * deleted colleague's actions must not turn into "the hourly sync" — that is
   * the opposite of an audit trail.
   */
  actor String?

  /// A short verb: campaign.create, reply.send, prospect.stop, block.add.
  action String

  /// What it acted on, already readable — an address, a campaign name.
  subject String

  /// Anything worth keeping that is not the subject. Free text, never parsed.
  detail String?

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([action])
}

model AppSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
}

/// One pass of the automatic sync.
///
/// Every part is recorded whether it succeeded or not, because the parts fail
/// independently: the reply pull needs a signed-in browser and stops working
/// the moment Edge is closed, while campaigns and leads keep going over the
/// plain API. A run where four parts worked and one didn't is the normal case,
/// and the panel has to be able to say which.
model SyncRun {
  id String @id @default(cuid())

  /// timer | manual | cron — how this run was started.
  trigger     String
  started_at  DateTime  @default(now())
  finished_at DateTime?

  /// True only when every part finished without error.
  ok Boolean @default(false)

  /**
   * The server stopped before this pass got through its parts.
   *
   * Distinct from `ok`, and the distinction decides when the next pass runs: a
   * pass that ran everything and had a part fail still counts as this hour's
   * pass, while one that was cut short did not happen and must not hold the
   * schedule for an hour on the strength of a row it left behind.
   */
  interrupted Boolean @default(false)

  /// Per-part outcome: [{ part, ok, detail, ms, error }].
  parts String @default("[]")

  /**
   * Where the resumable lead walk got to.
   *
   * QuickMail caps leads at 10 per page, so a full pass over ~50,000 of them is
   * about 4,800 requests — well over an hour at the rate limit, and therefore
   * impossible to finish inside an hourly slot. Each run walks a bounded slice
   * and hands the cursor to the next one; when the walk reaches the end the
   * cursor resets and the next pass starts over.
   */
  lead_cursor String?
  lead_done   Int     @default(0)
  lead_total  Int     @default(0)

  @@index([started_at])
}
